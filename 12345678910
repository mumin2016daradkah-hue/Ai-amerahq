<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>مبتكرة - المساعد الذكي للطلاب | أميرة</title>
<meta name="description" content="مبتكرة مساعد ذكاء اصطناعي مجاني للطلاب: يكتب الأبحاث والمقالات، يحل الواجبات، يصمم العروض التقديمية، ويحلل الصور والفيديوهات.">
<meta name="keywords" content="مبتكرة, أميرة, ذكاء اصطناعي, مساعد طلاب, كتابة أبحاث, حل واجبات, عرض تقديمي">
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Tahoma, Arial, sans-serif; background: #0f172a; color: #e2e8f0; height: 100vh; display: flex; flex-direction: column; }
  header { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; background: #1e293b; }
  header h1 { margin: 0; font-size: 22px; color: #a78bfa; }
  button { cursor: pointer; border: none; border-radius: 8px; padding: 10px 16px; background: #7c3aed; color: #fff; font-size: 15px; }
  button:hover { background: #6d28d9; }
  #settings { padding: 16px 20px; background: #1e293b; border-top: 1px solid #334155; display: grid; gap: 10px; }
  input, select, textarea { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #334155; background: #0f172a; color: #e2e8f0; font-size: 15px; }
  #chat { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .msg { max-width: 85%; padding: 12px 16px; border-radius: 12px; line-height: 1.8; white-space: pre-wrap; word-wrap: break-word; }
  .user { align-self: flex-end; background: #4c1d95; }
  .bot { align-self: flex-start; background: #1e293b; }
  .bot .actions { margin-top: 8px; }
  .bot .actions button { padding: 6px 12px; font-size: 13px; background: #334155; margin-left: 6px; }
  #previews { display: flex; gap: 8px; padding: 0 20px; flex-wrap: wrap; }
  #previews img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; }
  form { display: grid; grid-template-columns: auto auto 1fr auto; gap: 8px; padding: 14px 20px; background: #1e293b; align-items: end; }
  .attach { font-size: 24px; cursor: pointer; padding: 8px; }
  footer { text-align: center; font-size: 13px; color: #94a3b8; padding: 6px; }
</style>
</head>
<body>

<header>
  <h1>✨ مبتكرة</h1>
  <button id="settingsBtn">⚙️ الإعدادات</button>
</header>

<div id="settings" hidden>
  <input id="apiKey" type="password" placeholder="مفتاح API (يُحفظ في متصفحك فقط)">
  <input id="baseUrl" placeholder="عنوان الخدمة (Base URL)">
  <input id="model" placeholder="اسم النموذج الذي يدعم الصور">
  <button id="saveSettings">حفظ</button>
</div>

<main style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
  <div id="chat">
    <div class="msg bot">أهلاً، أنا مبتكرة 🌟 اكتب سؤالك أو واجبك، أو أرفق صورة أو فيديو، واختر الوضع المناسب من القائمة.</div>
  </div>
  <div id="previews"></div>
  <form id="form">
    <select id="mode">
      <option value="general">عام</option>
      <option value="homework">حل واجب</option>
      <option value="research">بحث أكاديمي</option>
      <option value="article">مقال</option>
      <option value="slides">عرض تقديمي</option>
    </select>
    <label class="attach" title="إرفاق صورة أو فيديو">📎<input id="file" type="file" accept="image/*,video/*" hidden></label>
    <textarea id="input" rows="2" placeholder="اكتب هنا..."></textarea>
    <button type="submit">إرسال</button>
  </form>
</main>
<footer>مبتكرة مشروع مجاني مفتوح المصدر</footer>

<script>
const $ = id => document.getElementById(id);

const SYSTEM = {
  general: "أنت مبتكرة، مساعد ذكي ودود للطلاب. أجب بالعربية الفصحى الواضحة ما لم يطلب المستخدم لغة أخرى.",
  homework: "أنت مساعد واجبات للطلاب. اشرح الحل خطوة بخطوة مع التعليل، ولا تكتفِ بالنتيجة النهائية حتى يفهم الطالب.",
  research: "أنت كاتب أبحاث أكاديمية. اكتب بحثاً منظماً يشمل: العنوان، المقدمة، مشكلة البحث، الأهداف، المحاور، الخاتمة، وقائمة مراجع مقترحة يجب على الطالب التحقق منها بنفسه.",
  article: "أنت كاتب مقالات. اكتب مقالاً متماسكاً بعنوان جذاب ومقدمة وعناصر فرعية وخاتمة، بأسلوب واضح.",
  slides: "أنت مصمم عروض تقديمية. قسّم المحتوى إلى شرائح؛ لكل شريحة: عنوان، ونقاط مختصرة، واقتراح لصورة، وملاحظات للمتحدث."
};

let attachments = [];   // صور مرفقة (data URLs)
let history = [];       // سجل المحادثة

// ---------- الإعدادات ----------
const defaults = {
  baseUrl: "https://api.groq.com/openai/v1",
  model: "llama-3.2-11b-vision-preview"   // تحقق من أحدث اسم نموذج في موقع المزود
};
$("baseUrl").value = localStorage.getItem("mb_base") || defaults.baseUrl;
$("model").value = localStorage.getItem("mb_model") || defaults.model;
$("apiKey").value = localStorage.getItem("mb_key") || "";

$("settingsBtn").onclick = () => $("settings").hidden = !$("settings").hidden;
$("saveSettings").onclick = () => {
  localStorage.setItem("mb_key", $("apiKey").value.trim());
  localStorage.setItem("mb_base", $("baseUrl").value.trim());
  localStorage.setItem("mb_model", $("model").value.trim());
  $("settings").hidden = true;
  alert("تم الحفظ ✔");
};

// ---------- الصور والفيديو ----------
function resizeImage(img, max = 1024) {
  const scale = Math.min(1, max / Math.max(img.width, img.height));
  const c = document.createElement("canvas");
  c.width = img.width * scale; c.height = img.height * scale;
  c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
  return c.toDataURL("image/jpeg", 0.85);
}

function readImageFile(file) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => resolve(resizeImage(img));
    img.onerror = reject;
    img.src = URL.createObjectURL(file);
  });
}

// استخراج 4 إطارات من الفيديو لأن النماذج تفهم الصور لا الفيديو مباشرة
function extractFramesFromVideo(file, count = 4) {
  return new Promise((resolve, reject) => {
    const video = document.createElement("video");
    video.src = URL.createObjectURL(file);
    video.muted = true;
    video.onloadeddata = async () => {
      const frames = [];
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d");
      for (let i = 1; i <= count; i++) {
        video.currentTime = (video.duration * i) / (count + 1);
        await new Promise(r => video.onseeked = r);
        canvas.width = Math.min(video.videoWidth, 768);
        canvas.height = canvas.width * video.videoHeight / video.videoWidth;
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        frames.push(canvas.toDataURL("image/jpeg", 0.8));
      }
      resolve(frames);
    };
    video.onerror = reject;
  });
}

$("file").onchange = async e => {
  const file = e.target.files[0];
  if (!file) return;
  try {
    const frames = file.type.startsWith("video")
      ? await extractFramesFromVideo(file)
      : [await readImageFile(file)];
    attachments.push(...frames);
    renderPreviews();
  } catch {
    alert("تعذّر قراءة الملف");
  }
  e.target.value = "";
};

function renderPreviews() {
  $("previews").innerHTML = "";
  attachments.forEach((src, i) => {
    const img = new Image();
    img.src = src;
    img.title = "اضغط للإزالة";
    img.onclick = () => { attachments.splice(i, 1); renderPreviews(); };
    $("previews").appendChild(img);
  });
}

// ---------- الإرسال ----------
function addMessage(text, who) {
  const div = document.createElement("div");
  div.className = "msg " + who;
  div.textContent = text;
  $("chat").appendChild(div);
  $("chat").scrollTop = $("chat").scrollHeight;
  return div;
}

function addBotMessage(text) {
  const div = addMessage(text, "bot");
  const bar = document.createElement("div");
  bar.className = "actions";
  const copy = document.createElement("button");
  copy.textContent = "نسخ";
  copy.onclick = () => navigator.clipboard.writeText(text);
  const dl = document.createElement("button");
  dl.textContent = "تحميل TXT";
  dl.onclick = () => {
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([text], { type: "text/plain;charset=utf-8" }));
    a.download = "mubtakira.txt";
    a.click();
  };
  bar.append(copy, dl);
  div.appendChild(bar);
}

$("form").onsubmit = async e => {
  e.preventDefault();
  const text = $("input").value.trim();
  if (!text && attachments.length === 0) return;

  const key = localStorage.getItem("mb_key");
  const base = localStorage.getItem("mb_base") || defaults.baseUrl;
  const model = localStorage.getItem("mb_model") || defaults.model;
  if (!key) {
    $("settings").hidden = false;
    alert("أدخل مفتاح API أولاً في الإعدادات");
    return;
  }

  const mode = $("mode").value;
  const content = [];
  if (text) content.push({ type: "text", text });
  attachments.forEach(url => content.push({ type: "image_url", image_url: { url } }));

  addMessage(text + (attachments.length ? `\n[مرفق: ${attachments.length} صورة]` : ""), "user");
  history.push({ role: "user", content });
  attachments = []; renderPreviews();
  $("input").value = "";

  const thinking = addMessage("جارٍ التفكير...", "bot");

  try {
    const res = await fetch(base.replace(/\/$/, "") + "/chat/completions", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Authorization": "Bearer " + key },
      body: JSON.stringify({
        model,
        messages: [{ role: "system", content: SYSTEM[mode] }, ...history.slice(-10)]
      })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error?.message || res.statusText);
    const answer = data.choices[0].message.content;
    history.push({ role: "assistant", content: answer });
    thinking.remove();
    addBotMessage(answer);
  } catch (err) {
    thinking.textContent = "حدث خطأ: " + err.message;
  }
};

$("input").addEventListener("keydown", e => {
  if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); $("form").requestSubmit(); }
});
</script>
</body>
</html>
